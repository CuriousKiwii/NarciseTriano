---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Icon from "../components/Icon.astro";
import TierCard from "../components/TierCard.astro";
import FundraisingMeter from "../components/FundraisingMeter.astro";
import { u } from "../lib/url";
import {
  driver,
  contact,
  stats,
  ticker,
  timeline,
  results,
  story,
  whyPartner,
  tiers,
  tiersStartingAt,
  gallery,
  photoCredit,
  heroVideo,
  headshot,
  logo,
  donateUrl,
} from "../data/site";

const chevrons = "&gt;".repeat(120);
const podiumCount = results.weekends.flatMap((w) => w.races).filter((r) => /^P[1-3]$/.test(r.result)).length;
---

<Base>
  <!-- HERO: full-bleed video, inspired by Piastri/Leclerc. Poster paints first, video fades in after load. -->
  <section
    id="hero"
    class="relative isolate overflow-hidden bg-surface-lowest min-h-[calc(100svh-5rem)] flex flex-col"
    aria-label={`${driver.name}, ${driver.category} driver`}
  >
    <div class="absolute inset-0 -z-10">
      <picture>
        <source media="(orientation: portrait)" srcset={u(heroVideo.posterPortrait)} />
        <source srcset={`${u("/images/hero-poster-sm.jpg")} 720w, ${u(heroVideo.poster)} 1600w`} sizes="100vw" />
        <img
          src={u(heroVideo.poster)}
          alt={heroVideo.alt}
          class="absolute inset-0 w-full h-full object-cover object-[62%_35%]"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <video
        id="hero-video"
        class="absolute inset-0 w-full h-full object-cover object-[62%_35%] opacity-0 transition-opacity duration-1000"
        muted
        playsinline
        loop
        preload="none"
        aria-hidden="true"
        data-portrait={u(heroVideo.portrait)}
        data-md={u(heroVideo.md)}
        data-lg={u(heroVideo.lg)}
      ></video>
      <div class="absolute inset-0 bg-gradient-to-t from-surface-lowest via-surface-lowest/35 to-surface-lowest/20"></div>
      <div class="absolute inset-0 hidden md:block bg-gradient-to-r from-surface-lowest/85 via-surface-lowest/25 to-transparent"></div>
    </div>

    <div class="hero-number hidden md:block" aria-hidden="true">{driver.carNumber}</div>

    <div class="relative mt-auto w-full max-w-7xl mx-auto px-5 md:px-gutter pt-40 pb-10 md:pb-14">
      <div class="hero-in inline-flex px-3 py-1 bg-red text-red-ink telemetry mb-5">Road to {driver.goal}</div>
      <h1 class="hero-in headline font-extrabold text-6xl sm:text-7xl md:text-hero tracking-tight" style="--i:1">
        Purpose. Speed.<br class="sm:hidden" /> <span class="text-red italic speed-stripe">Impact.</span>
      </h1>
      <p class="hero-in headline font-semibold text-2xl md:text-3xl text-ink-muted mt-4" style="--i:2">
        {driver.name} <span class="text-red-soft">// #{driver.carNumber}</span>
        <span class="hidden sm:inline text-ink-dim">&nbsp;// {driver.team}</span>
      </p>
      <div class="hero-in flex flex-wrap gap-3 mt-8" style="--i:3">
        <a href={u("/partner")} class="btn btn-red">Partner with me <Icon name="bolt" /></a>
        <a href={donateUrl} target="_blank" rel="noopener" class="btn btn-ghost">Support my journey</a>
      </div>
    </div>

    <div class="relative border-t border-ink/10 bg-surface-lowest/70 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-5 md:px-gutter h-12 flex items-center gap-6 telemetry text-ink-muted">
        <span class="hidden md:inline text-red-soft">{driver.category} // {driver.series}</span>
        <span class="hidden sm:inline">First season // 3 podiums, 1 pole</span>
        <span class="truncate">Next // Full {driver.nextSeason} season, then {driver.goal}</span>
        <button
          id="hero-video-toggle"
          type="button"
          class="hidden ml-auto shrink-0 w-8 h-8 items-center justify-center text-ink hover:text-red-soft transition-colors"
          aria-label="Pause background video"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path data-icon="pause" d="M6 4h4v16H6zM14 4h4v16h-4z" />
            <path data-icon="play" class="hidden" d="M7 4v16l13-8z" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- TICKER -->
  <section class="bg-surface-lowest overflow-hidden py-2" aria-label="Season ticker">
    <div class="flex w-max animate-marquee gap-10 telemetry text-ink-muted">
      {
        [...ticker, ...ticker].map((t, i) => (
          <span class="flex items-center gap-3 whitespace-nowrap" aria-hidden={i >= ticker.length ? "true" : undefined}>
            <span class="w-1.5 h-1.5 rounded-full bg-red" />
            {t}
          </span>
        ))
      }
    </div>
  </section>

  <!-- STAT STRIP -->
  <section class="bg-red text-red-ink py-6" aria-label="Key stats">
    <div class="max-w-7xl mx-auto px-5 md:px-gutter grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-gutter">
      {
        stats.map((s) => (
          <div class="flex flex-col p-4 bg-red-deep/40" data-reveal>
            <span class="headline font-extrabold text-5xl md:text-6xl xl:text-7xl my-1 text-white tabular-nums" data-count>{s.value}</span>
            <span class="font-semibold uppercase">{s.label}</span>
            <span class="text-xs mt-1 text-red-ink/80">{s.note}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- QUOTE -->
  <section class="bg-surface-lowest py-16 md:py-24" aria-label="In her words">
    <figure class="max-w-5xl mx-auto px-5 md:px-gutter" data-reveal>
      <div class="w-12 h-1 bg-red mb-8"></div>
      <blockquote class="headline font-semibold text-4xl sm:text-5xl md:text-6xl leading-[1.05]">
        {driver.quote}
      </blockquote>
      <figcaption class="mt-8 flex items-center gap-5">
        <Photo src={logo.white} alt={logo.alt} class="h-16 w-auto" />
        <span class="telemetry text-red-soft">{driver.name} // {driver.location}</span>
      </figcaption>
    </figure>
  </section>

  <!-- STORY -->
  <section id="story" class="bg-surface-low py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-5 md:px-gutter grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
      <div class="lg:col-span-7 flex flex-col gap-6">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 bg-red"></span>
          <span class="telemetry text-red-soft">My story</span>
        </div>
        <h2 class="headline text-5xl md:text-6xl">Started late. <span class="text-red">Never stopped.</span></h2>
        <p class="text-xl leading-relaxed text-ink font-semibold">{story.short}</p>
        <div class="flex flex-col gap-4 bg-surface-mid p-6 md:p-8 text-ink-muted leading-relaxed">
          <p class="text-lg text-ink">{story.intro}</p>
          {story.full.map((p) => <p>{p}</p>)}
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={u("/partner")} class="btn btn-red">Become a partner //</a>
          <a href={donateUrl} target="_blank" rel="noopener" class="btn btn-ghost">Support my journey</a>
        </div>
      </div>

      <aside class="lg:col-span-5 bg-surface-mid p-6 flex flex-col gap-6">
        <div class="relative h-96 overflow-hidden bg-surface-lowest">
          <Photo src={headshot.src} alt={headshot.alt} sizes="(min-width: 1024px) 40vw, 100vw" class="absolute inset-0 w-full h-full object-cover object-[50%_20%]" />
          <div class="absolute bottom-0 inset-x-0 p-4 bg-gradient-to-t from-surface-lowest/95 via-surface-lowest/60 to-transparent">
            <span class="font-mono text-micro uppercase text-red-soft">Driver // {driver.location}</span>
            <div class="headline text-3xl">{driver.name}</div>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-red animate-ping"></span>
            <span class="telemetry">Road so far</span>
          </div>
          <span class="telemetry text-red-soft">Next: {driver.nextSeason}</span>
        </div>

        <ol data-reveal-stagger class="relative flex flex-col gap-5 pl-6 before:absolute before:left-[7px] before:top-1 before:bottom-1 before:w-0.5 before:bg-surface-highest">
          {
            timeline.map((t) => (
              <li class="relative">
                <span
                  class:list={[
                    "absolute -left-6 top-1 w-4 h-4 flex items-center justify-center",
                    t.done ? "bg-red" : "bg-surface-highest ring-2 ring-red",
                  ]}
                >
                  {t.done && <Icon name="check" class="w-3 h-3 text-white" />}
                </span>
                <span class="font-mono text-micro uppercase text-red-soft">{t.label}</span>
                <h3 class="headline text-2xl">{t.title}</h3>
                <p class="text-sm text-ink-muted">{t.body}</p>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>
  </section>

  <!-- RESULTS -->
  <section id="results" class="bg-surface-lowest py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-5 md:px-gutter flex flex-col gap-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4" data-reveal>
        <div>
          <span class="telemetry text-red-soft block mb-2">{results.season} results // {driver.seriesShort}</span>
          <h2 class="headline text-5xl md:text-6xl">{podiumCount} podiums. <span class="text-red">4 races.</span></h2>
        </div>
        <p class="max-w-md text-ink-muted">{results.summary}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter" data-reveal-stagger>
        {
          results.weekends.map((w) => (
            <article class="relative bg-surface-mid p-6 overflow-hidden">
              <div class="absolute left-0 top-0 w-1.5 h-full bg-red" />
              <div class="flex items-center justify-between telemetry text-ink-muted">
                <span>{w.month}</span>
                <span class="text-red-soft">Car {w.car}</span>
              </div>
              <h3 class="headline text-3xl sm:text-4xl mt-2">{w.track}</h3>
              <div class="grid grid-cols-2 gap-3 mt-5">
                {w.races.map((r) => (
                  <div class:list={["p-4 flex flex-col", /^P[1-3]$/.test(r.result) ? "bg-red text-white" : "bg-surface-high"]}>
                    <span class="font-mono text-micro uppercase opacity-80">{r.name}</span>
                    <span class="headline font-extrabold text-5xl">{r.result}</span>
                  </div>
                ))}
              </div>
            </article>
          ))
        }
      </div>
      <p class="flex gap-3 p-4 bg-surface-low text-sm text-ink-muted">
        <Icon name="flag" class="w-5 h-5 shrink-0 text-red-soft" />
        <span>Qualifying: {results.qualifying}</span>
      </p>
    </div>
  </section>

  <!-- FUNDRAISING -->
  <section class="bg-surface-low py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-5 md:px-gutter">
      <FundraisingMeter />
    </div>
  </section>

  <!-- WHY PARTNER -->
  <section class="bg-surface-lowest py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-5 md:px-gutter flex flex-col gap-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4" data-reveal>
        <div>
          <span class="telemetry text-red-soft block mb-2">Why partner with me</span>
          <h2 class="headline text-5xl md:text-6xl">Your brand, <span class="text-red">on the climb.</span></h2>
        </div>
        <p class="max-w-md text-ink-muted">
          A racing partnership puts your brand in front of an engaged, growing motorsport audience, alongside a driver
          climbing the single-seater ladder toward professional racing.
        </p>
      </div>
      <div class="chevrons text-red/40" aria-hidden="true" ><span class="chev-track" set:html={chevrons} /></div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter" data-reveal-stagger>
        {
          whyPartner.map((w, i) => (
            <div class="relative bg-surface-mid p-6 overflow-hidden">
              <div class="absolute left-0 top-0 w-1.5 h-full bg-red" />
              <span class="telemetry text-red-soft">0{i + 1}</span>
              <h3 class="headline text-3xl mt-2">{w.title}</h3>
              <p class="text-sm text-ink-muted mt-2">{w.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section id="gallery" class="bg-surface-low py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-5 md:px-gutter flex flex-col gap-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4" data-reveal>
        <div>
          <span class="telemetry text-red-soft block mb-2">Track record // Photo archive</span>
          <h2 class="headline text-5xl md:text-6xl">From the <span class="text-red">paddock</span></h2>
        </div>
        <div class="flex items-center gap-4">
          <a href={contact.instagram.url} target="_blank" rel="noopener" class="telemetry text-red-soft hover:text-ink flex items-center gap-2">
            More on Instagram <Icon name="external" class="w-4 h-4" />
          </a>
          <div class="hidden md:flex gap-2">
            <button type="button" class="gal-nav" data-gal="-1" aria-label="Previous photos">
              <Icon name="arrow" class="w-5 h-5 rotate-180" />
            </button>
            <button type="button" class="gal-nav" data-gal="1" aria-label="Next photos">
              <Icon name="arrow" class="w-5 h-5" />
            </button>
          </div>
        </div>
      </div>
      <div class="chevrons text-red" aria-hidden="true"><span class="chev-track" set:html={chevrons} /></div>
    </div>

    <div
      id="gallery-track"
      class="gallery-track mt-8 flex gap-4 md:gap-gutter overflow-x-auto snap-x snap-mandatory px-5 md:px-[max(2rem,calc((100vw-80rem)/2+2rem))] scroll-px-5 md:scroll-px-[max(2rem,calc((100vw-80rem)/2+2rem))]"
      tabindex="0"
      aria-label="Photo gallery, scroll sideways"
    >
      {
        gallery.map((g, i) => (
          <figure class="snap-start shrink-0 w-[82vw] sm:w-[46vw] lg:w-[30rem] bg-surface-mid flex flex-col">
            <button
              type="button"
              class="group relative block h-72 sm:h-80 overflow-hidden text-left cursor-zoom-in"
              data-lb={i}
              aria-label={`View ${g.title} full screen`}
            >
              <Photo
                src={g.src}
                alt={g.alt}
                sizes="(min-width: 1024px) 480px, (min-width: 640px) 46vw, 82vw"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                style={`object-position:${g.position}`}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface-mid via-transparent to-transparent opacity-80" />
              <span class="absolute top-3 left-3 bg-surface-lowest/90 px-2 py-0.5 telemetry text-red-soft">{g.tag}</span>
              <span class="absolute top-3 right-3 w-9 h-9 flex items-center justify-center bg-surface-lowest/80 text-ink opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity" aria-hidden="true">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
              </span>
            </button>
            <figcaption class="p-5">
              <h3 class="headline text-3xl">{g.title}</h3>
              <p class="text-sm text-ink-muted mt-1">{g.caption}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="max-w-7xl mx-auto px-5 md:px-gutter mt-6 flex items-center justify-between gap-6">
      <div class="flex-1 h-0.5 bg-surface-highest overflow-hidden" aria-hidden="true">
        <div id="gallery-progress" class="h-full bg-red origin-left" style="transform:scaleX(0.15)"></div>
      </div>
      <p class="font-mono text-micro uppercase text-ink-dim">{photoCredit}</p>
    </div>

    <dialog id="lightbox" class="lightbox" aria-label="Photo viewer">
      <div class="lb-stage">
        <img id="lb-img" alt="" />
      </div>
      <div class="lb-bar">
        <div class="min-w-0">
          <span id="lb-count" class="block telemetry text-red-soft truncate"></span>
          <p id="lb-title" class="headline text-2xl md:text-3xl truncate"></p>
          <p id="lb-caption" class="text-sm text-ink-muted truncate"></p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button type="button" class="gal-nav" data-lb-step="-1" aria-label="Previous photo"><Icon name="arrow" class="w-5 h-5 rotate-180" /></button>
          <button type="button" class="gal-nav" data-lb-step="1" aria-label="Next photo"><Icon name="arrow" class="w-5 h-5" /></button>
          <button type="button" class="gal-nav" id="lb-fs" aria-label="Full screen">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
          </button>
          <button type="button" class="gal-nav" id="lb-close" aria-label="Close"><Icon name="close" class="w-5 h-5" /></button>
        </div>
      </div>
    </dialog>
    <script
      type="application/json"
      id="gallery-data"
      set:html={JSON.stringify(gallery.map((g) => ({ src: u(g.src), alt: g.alt, title: g.title, caption: g.caption, tag: g.tag })))}
    />
  </section>

  <!-- PARTNER CTA -->
  <section class="bg-surface-lowest py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-5 md:px-gutter flex flex-col gap-10">
      <div class="relative bg-red p-6 sm:p-8 md:p-12 overflow-hidden" data-reveal>
        <img src={u(logo.white)} alt="" aria-hidden="true" class="absolute -right-6 -bottom-6 w-64 sm:w-96 opacity-15 select-none pointer-events-none" />
        <div class="relative max-w-3xl flex flex-col gap-4">
          <span class="self-start bg-red-deep px-3 py-1 telemetry">// Get in early</span>
          <h2 class="headline font-extrabold text-5xl md:text-hero text-white">Join the team.</h2>
          <p class="text-lg text-red-ink leading-relaxed">
            F1 Academy races run alongside F1 race weekends and plug into F1's global broadcast. Partners who sign on
            now lock in today's rate and grow right along with the audience.
          </p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
        <div>
          <h3 class="headline text-3xl">Partnership tiers</h3>
          <p class="text-sm text-ink-muted">Partnerships starting at {tiersStartingAt}. Contact me for details.</p>
        </div>
        <a href={u("/partner#tiers")} class="telemetry text-red-soft hover:text-ink flex items-center gap-2">
          Full details <Icon name="arrow" class="w-4 h-4" />
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {tiers.map((t, i) => <TierCard tier={t} index={i} compact />)}
      </div>

      <div class="p-6 bg-surface-mid flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <span class="headline text-3xl">Follow the journey</span>
          <p class="text-sm text-ink-muted mt-1">Race weekends, training, and behind-the-scenes on Instagram, TikTok, and YouTube.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={contact.instagram.url} target="_blank" rel="noopener" class="btn btn-ghost !text-xl" aria-label="Instagram">
            <Icon name="instagram" /> Instagram
          </a>
          <a href={contact.tiktok.url} target="_blank" rel="noopener" class="btn btn-ghost !text-xl" aria-label="TikTok">
            <Icon name="tiktok" /> TikTok
          </a>
          <a href={contact.youtube.url} target="_blank" rel="noopener" class="btn btn-ghost !text-xl" aria-label="YouTube">
            <Icon name="youtube" /> YouTube
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
