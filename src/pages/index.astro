---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Icon from "../components/Icon.astro";
import TierCard from "../components/TierCard.astro";
import {
  driver,
  contact,
  stats,
  ticker,
  timeline,
  carGoal,
  whyPartner,
  tiers,
  gallery,
  heroImage,
  prospectusPdf,
} from "../data/site";

const pct = carGoal.raised != null ? Math.min(100, (carGoal.raised / carGoal.amount) * 100) : null;
const usd = (n: number) => n.toLocaleString("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
const chevrons = "&gt;".repeat(120);
---

<Base>
  <!-- TICKER -->
  <section class="bg-surface-lowest overflow-hidden py-2" aria-label="Season ticker">
    <div class="flex w-max animate-marquee gap-10 telemetry text-ink-muted">
      {
        [...ticker, ...ticker].map((t, i) => (
          <span class="flex items-center gap-3 whitespace-nowrap" aria-hidden={i >= ticker.length ? "true" : undefined}>
            <span class="w-1.5 h-1.5 rounded-full bg-red" />
            {t}
          </span>
        ))
      }
    </div>
  </section>

  <!-- HERO -->
  <section class="relative overflow-hidden bg-surface-lowest py-10 md:py-14">
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none opacity-[0.04]" aria-hidden="true">
      <span class="headline font-extrabold text-[150px] md:text-[260px] whitespace-nowrap">F4 #{driver.carNumber}</span>
    </div>

    <div class="relative max-w-7xl mx-auto px-5 md:px-gutter">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
        <div>
          <div class="inline-flex px-3 py-1 bg-red text-red-ink telemetry mb-3">Road to {driver.goal}</div>
          <h1 class="headline font-extrabold text-6xl md:text-hero tracking-tight">
            Purpose. Speed. <span class="text-red italic">Impact.</span>
          </h1>
          <p class="headline font-semibold text-2xl md:text-3xl text-ink-muted mt-2">
            {driver.name} <span class="text-red-soft">// Car #{driver.carNumber}</span>
          </p>
        </div>
        <div class="flex flex-col gap-1 md:text-right">
          <span class="telemetry text-ink-muted">Formula 4 // {driver.team}</span>
          <span class="telemetry text-red-soft">{driver.series}</span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
        <div class="lg:col-span-4 flex flex-col justify-between gap-5 bg-surface-low p-6 order-2 lg:order-1">
          <div class="flex flex-col gap-5">
            <div class="flex items-center justify-between">
              <span class="telemetry text-ink-muted">Driver profile</span>
              <span class="font-mono text-micro uppercase bg-surface-mid px-2 py-0.5 text-red-soft">Status: Pursuit</span>
            </div>
            <figure class="relative bg-surface-high p-5">
              <div class="absolute left-0 top-0 w-1 h-full bg-red"></div>
              <blockquote class="italic leading-relaxed">{driver.quote}</blockquote>
              <figcaption class="telemetry text-red-soft mt-3">{driver.name}</figcaption>
            </figure>
            <dl class="flex flex-col gap-2">
              <div class="flex items-center justify-between p-3 bg-surface-mid">
                <dt class="telemetry text-ink-muted">Podiums</dt>
                <dd class="headline text-3xl">3 of 4 races</dd>
              </div>
              <div class="flex items-center justify-between p-3 bg-surface-mid">
                <dt class="telemetry text-ink-muted">Team</dt>
                <dd class="headline text-3xl text-red-soft">{driver.team}</dd>
              </div>
              <div class="flex items-center justify-between p-3 bg-surface-mid">
                <dt class="telemetry text-ink-muted">Licensed</dt>
                <dd class="telemetry">SCCA // Radford</dd>
              </div>
            </dl>
          </div>
          <a href="/partner" class="btn btn-red w-full">Back the drive <Icon name="bolt" /></a>
        </div>

        <div class="lg:col-span-8 relative min-h-[380px] md:min-h-[480px] overflow-hidden group order-1 lg:order-2 flex flex-col justify-end">
          <Photo
            src={heroImage.src}
            alt={heroImage.alt}
            eager
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-surface-lowest via-surface-lowest/30 to-transparent"></div>
          <div class="absolute top-4 right-4 px-4 py-1.5 bg-surface-lowest/90 backdrop-blur-md">
            <span class="telemetry text-red-soft">{heroImage.label}</span>
          </div>
          <div class="relative p-6 flex flex-wrap items-end justify-between gap-4">
            <div>
              <span class="font-mono text-micro uppercase text-red-soft">Next step</span>
              <div class="headline font-extrabold text-5xl">Own the car. <span class="text-red">Reach F1 Academy.</span></div>
            </div>
            <div class="bg-red px-4 py-2 text-red-ink telemetry">Season {driver.season} // {driver.seriesShort}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STAT STRIP -->
  <section class="bg-red text-red-ink py-6" aria-label="Key stats">
    <div class="max-w-7xl mx-auto px-5 md:px-gutter grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-gutter">
      {
        stats.map((s) => (
          <div class="flex flex-col p-4 bg-red-deep/40">
            <span class="headline font-extrabold text-5xl md:text-6xl xl:text-7xl my-1 text-white">{s.value}</span>
            <span class="font-semibold uppercase">{s.label}</span>
            <span class="text-xs mt-1 text-red-ink/80">{s.note}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- STORY -->
  <section id="story" class="bg-surface-low py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-5 md:px-gutter grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
      <div class="lg:col-span-7 flex flex-col gap-6">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 bg-red"></span>
          <span class="telemetry text-red-soft">My story // Dossier #{driver.carNumber}</span>
        </div>
        <h2 class="headline text-5xl md:text-6xl">The pursuit of the <span class="text-red">F1 Academy grid</span></h2>
        <div class="flex flex-col gap-4 bg-surface-mid p-6 md:p-8 text-ink-muted leading-relaxed">
          <p class="text-lg text-ink font-semibold">
            Hi, I'm Narcisse. My dream is to race professionally and one day compete in F1 Academy. Racing is my
            purpose and my drive, and it's how I want to inspire others to chase the impossible.
          </p>
          <p>
            I earned my SCCA license at Radford Racing School in Arizona and sharpened my racecraft in the K1 Speed
            Racing League in Phoenix. Today I drive Formula 4 for {driver.team} in the {driver.series}, and I opened
            my first season with three podiums in four races.
          </p>
          <p>
            My next step is owning my own race car. F1 Academy drivers are backed by major companies once they're
            picked up, but getting there means proving myself with my own program first. That's where partners come in.
          </p>
          <p>
            I'm doing this out of faith. I've put everything I have into it: my time, my training, my own money. I'm
            not asking anyone to give what I haven't already given myself. Every dollar, every product, and every bit
            of support goes straight toward getting me on track and one step closer.
          </p>
        </div>
        <div class="flex flex-wrap gap-4">
          <a href="/partner" class="btn btn-red">Become a partner //</a>
          <a href={prospectusPdf} download class="btn btn-ghost"><Icon name="download" /> Sponsor deck</a>
        </div>
      </div>

      <!-- Road so far HUD -->
      <aside id="season" class="lg:col-span-5 bg-surface-mid p-6 flex flex-col gap-6 lg:sticky lg:top-28">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-red animate-ping"></span>
            <span class="telemetry">Road so far</span>
          </div>
          <span class="telemetry text-red-soft">Season {driver.season}</span>
        </div>

        <ol class="relative flex flex-col gap-5 pl-6 before:absolute before:left-[7px] before:top-1 before:bottom-1 before:w-0.5 before:bg-surface-highest">
          {
            timeline.map((t) => (
              <li class="relative">
                <span
                  class:list={[
                    "absolute -left-6 top-1 w-4 h-4 flex items-center justify-center",
                    t.done ? "bg-red" : "bg-surface-highest ring-2 ring-red",
                  ]}
                >
                  {t.done && <Icon name="check" class="w-3 h-3 text-white" />}
                </span>
                <span class="font-mono text-micro uppercase text-red-soft">{t.label}</span>
                <h3 class="headline text-2xl">{t.title}</h3>
                <p class="text-sm text-ink-muted">{t.body}</p>
              </li>
            ))
          }
        </ol>

        <div class="bg-surface-lowest p-5 flex flex-col gap-2">
          <span class="font-mono text-micro uppercase text-ink-muted">Season goal // own my car</span>
          <div class="flex items-baseline gap-2">
            {
              pct != null ? (
                <>
                  <span class="headline font-extrabold text-5xl text-red-soft">{usd(carGoal.raised!)}</span>
                  <span class="text-sm text-ink-muted">/ {usd(carGoal.amount)}</span>
                </>
              ) : (
                <span class="headline font-extrabold text-5xl text-red-soft">~{usd(carGoal.amount)}</span>
              )
            }
          </div>
          {
            pct != null && (
              <div class="w-full h-3 bg-surface-mid mt-2" role="progressbar" aria-valuenow={Math.round(pct)} aria-valuemin="0" aria-valuemax="100">
                <div class="h-full bg-red" style={`width:${pct}%`} />
              </div>
            )
          }
          <p class="text-sm text-ink-muted">{carGoal.summary}</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- WHY PARTNER -->
  <section class="bg-surface-lowest py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-5 md:px-gutter flex flex-col gap-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="telemetry text-red-soft block mb-2">Why partner with me</span>
          <h2 class="headline text-5xl md:text-6xl">Your brand, <span class="text-red">on the climb.</span></h2>
        </div>
        <p class="max-w-md text-ink-muted">
          A racing partnership puts your brand in front of an engaged, growing motorsport audience, alongside a driver
          climbing the single-seater ladder toward professional racing.
        </p>
      </div>
      <div class="chevrons text-red/40" aria-hidden="true" set:html={chevrons} />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
        {
          whyPartner.map((w, i) => (
            <div class="relative bg-surface-mid p-6 overflow-hidden">
              <div class="absolute left-0 top-0 w-1.5 h-full bg-red" />
              <span class="telemetry text-red-soft">0{i + 1}</span>
              <h3 class="headline text-3xl mt-2">{w.title}</h3>
              <p class="text-sm text-ink-muted mt-2">{w.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section id="gallery" class="bg-surface-low py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-5 md:px-gutter flex flex-col gap-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="telemetry text-red-soft block mb-2">Track record // Photo archive</span>
          <h2 class="headline text-5xl md:text-6xl">From the <span class="text-red">paddock</span></h2>
        </div>
        <a href={contact.instagram.url} target="_blank" rel="noopener" class="telemetry text-red-soft hover:text-ink flex items-center gap-2">
          More on Instagram <Icon name="external" class="w-4 h-4" />
        </a>
      </div>
      <div class="chevrons text-red" aria-hidden="true" set:html={chevrons} />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        {
          gallery.map((g) => (
            <figure class="group bg-surface-mid flex flex-col overflow-hidden">
              <div class="relative h-80 overflow-hidden">
                <Photo src={g.src} alt={g.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-mid via-transparent to-transparent opacity-80" />
                <span class="absolute top-3 left-3 bg-surface-lowest/90 px-2 py-0.5 telemetry text-red-soft">{g.tag}</span>
              </div>
              <figcaption class="p-5">
                <div class="flex items-center justify-between telemetry text-ink-muted mb-1">
                  <span>{driver.seriesShort}</span>
                  <span class="text-red-soft">Car #{driver.carNumber}</span>
                </div>
                <h3 class="headline text-3xl">{g.title}</h3>
                <p class="text-sm text-ink-muted mt-1">{g.caption}</p>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PARTNER CTA -->
  <section class="bg-surface-lowest py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-5 md:px-gutter flex flex-col gap-10">
      <div class="relative bg-red p-8 md:p-12 overflow-hidden">
        <div class="absolute -right-10 -bottom-16 headline font-extrabold text-[200px] text-red-deep/60 select-none pointer-events-none" aria-hidden="true">
          #{driver.carNumber}
        </div>
        <div class="relative max-w-3xl flex flex-col gap-4">
          <span class="self-start bg-red-deep px-3 py-1 telemetry">// Get in early</span>
          <h2 class="headline font-extrabold text-5xl md:text-hero text-white">Join the team.</h2>
          <p class="text-lg text-red-ink leading-relaxed">
            F1 Academy races run alongside F1 race weekends and plug into F1's global broadcast. Partners who sign on
            now lock in today's rate and grow right along with the audience.
          </p>
        </div>
      </div>

      <div class="flex items-center justify-between">
        <h3 class="headline text-3xl">Partnership tiers</h3>
        <a href="/partner#tiers" class="telemetry text-red-soft hover:text-ink flex items-center gap-2">
          Full details <Icon name="arrow" class="w-4 h-4" />
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {tiers.map((t, i) => <TierCard tier={t} index={i} compact />)}
      </div>

      <div class="p-6 bg-surface-mid flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <span class="headline text-3xl">Follow the season in real time</span>
          <p class="text-sm text-ink-muted mt-1">Race weekends, training, and behind-the-scenes on Instagram and TikTok.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={contact.instagram.url} target="_blank" rel="noopener" class="btn btn-ghost !text-xl">
            <Icon name="instagram" /> @{contact.instagram.handle}
          </a>
          <a href={contact.tiktok.url} target="_blank" rel="noopener" class="btn btn-ghost !text-xl">
            <Icon name="tiktok" /> @{contact.tiktok.handle}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
