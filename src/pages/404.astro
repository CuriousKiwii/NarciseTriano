---
import Base from "../layouts/Base.astro";
---

<Base title="Off track | Narcisse Triano">
  <section class="min-h-[70vh] flex items-center bg-surface-lowest">
    <div class="max-w-7xl mx-auto px-5 md:px-gutter flex flex-col gap-6">
      <span class="self-start bg-red px-3 py-1 telemetry text-red-ink">Red flag // 404</span>
      <h1 class="headline font-extrabold text-6xl md:text-hero">Off track.</h1>
      <p class="text-ink-muted max-w-md">That page took a wrong turn. Head back to the pits and try again.</p>
      <a href="/" class="btn btn-red self-start">Back to the pits //</a>
    </div>
  </section>
</Base>
