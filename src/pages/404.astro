---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Icon from "../components/Icon.astro";
import { u } from "../lib/url";
import { driver } from "../data/site";
---

<Base title={`Off track | ${driver.name}`} description="This page went off track. Head back to the pit lane.">
  <div class="checker-wipe" aria-hidden="true"></div>

  <section class="relative isolate overflow-hidden bg-surface-lowest min-h-[calc(100svh-5rem)] flex flex-col">
    <div class="absolute inset-0 -z-10">
      <Photo
        src="/images/test-sunset-pass.jpg"
        alt=""
        eager
        sizes="100vw"
        class="absolute inset-0 w-full h-full object-cover object-[30%_60%]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-surface-lowest via-surface-lowest/50 to-surface-lowest/30"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-surface-lowest/90 via-surface-lowest/40 to-transparent"></div>
    </div>

    <div class="hero-number hidden md:block !text-[clamp(10rem,30vw,30rem)]" aria-hidden="true">404</div>

    <div class="relative mt-auto w-full max-w-7xl mx-auto px-5 md:px-gutter pt-32 pb-12 md:pb-16">
      <div class="hero-in inline-flex px-3 py-1 bg-red text-red-ink telemetry mb-5">Error // 404</div>
      <h1 class="hero-in headline font-extrabold text-7xl md:text-hero tracking-tight" style="--i:1">
        Off <span class="text-red italic speed-stripe">track.</span>
      </h1>
      <p class="hero-in max-w-xl text-lg text-ink-muted mt-5 leading-relaxed" style="--i:2">
        This page took the wrong line and ended up in the gravel. Let's get you back to the pit lane.
      </p>
      <div class="hero-in flex flex-wrap gap-3 mt-8" style="--i:3">
        <a href={u("/")} class="btn btn-red">Back to pit lane <Icon name="arrow" /></a>
        <a href={u("/#results")} class="btn btn-ghost">See results</a>
        <a href={u("/partner")} class="btn btn-ghost">Partner with me</a>
      </div>
    </div>

    <div class="relative border-t border-ink/10 bg-surface-lowest/70 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-5 md:px-gutter h-12 flex items-center gap-6 telemetry text-ink-muted overflow-hidden">
        <span class="text-red-soft">Lap 404</span>
        <span>Sector time // --:--.---</span>
        <span class="hidden sm:inline">Status // DNF, page not found</span>
      </div>
    </div>
  </section>
</Base>

<style>
  @media (prefers-reduced-motion: reduce) {
    .checker-wipe {
      display: none;
    }
  }
</style>
