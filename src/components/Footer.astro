---
import Icon from "./Icon.astro";
import { driver, contact, nav } from "../data/site";
import { u } from "../lib/url";
const year = new Date().getFullYear();
---

<footer class="bg-surface-lowest">
  <div class="max-w-7xl mx-auto px-5 md:px-gutter py-12 flex flex-col gap-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
      <div class="md:col-span-5 flex flex-col gap-3">
        <div class="flex items-center gap-2">
          <span class="w-2 h-5 bg-red"></span>
          <span class="headline text-2xl tracking-wider">{driver.name} // Road to {driver.goal}</span>
        </div>
        <p class="text-sm text-ink-muted max-w-md">
          Formula 4 driver with {driver.team} in the {driver.series}. Building toward {driver.goal}, one
          partnership at a time.
        </p>
      </div>

      <div class="md:col-span-3 flex flex-col gap-2">
        <span class="telemetry text-ink-dim">Navigate</span>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-1">
          {nav.map((n) => <li><a href={u(n.href)} class="text-sm text-ink-muted hover:text-ink">{n.label}</a></li>)}
        </ul>
      </div>

      <div class="md:col-span-4 flex flex-col gap-2">
        <span class="telemetry text-ink-dim">Follow the season</span>
        <a href={contact.instagram.url} target="_blank" rel="noopener" class="flex items-center gap-2 text-sm text-ink-muted hover:text-ink">
          <Icon name="instagram" class="w-4 h-4" /> Instagram @{contact.instagram.handle}
        </a>
        <a href={contact.tiktok.url} target="_blank" rel="noopener" class="flex items-center gap-2 text-sm text-ink-muted hover:text-ink">
          <Icon name="tiktok" class="w-4 h-4" /> TikTok @{contact.tiktok.handle}
        </a>
        <a href={`mailto:${contact.email}`} class="flex items-center gap-2 text-sm text-ink-muted hover:text-ink">
          <Icon name="mail" class="w-4 h-4" /> {contact.email}
        </a>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-surface-high">
      <span class="font-mono text-micro uppercase text-ink-dim">
        © {year} {driver.name} Racing #{driver.carNumber}. All rights reserved.
      </span>
      <span class="font-mono text-micro uppercase text-ink-dim">{contact.website}</span>
    </div>
  </div>
</footer>
