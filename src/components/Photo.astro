---
/**
 * Renders an image from /public if the file exists, otherwise a styled
 * placeholder that names the file to drop in.
 *
 * Mobile: if a "-sm" version sits next to the image (hero.jpg + hero-sm.jpg),
 * phones download the small one automatically via srcset.
 */
import fs from "node:fs";
import path from "node:path";
import { u } from "../lib/url";

interface Props {
  src: string;
  alt: string;
  class?: string;
  eager?: boolean;
  /** Rendered width hint for the browser, e.g. "(min-width: 1024px) 66vw, 100vw" */
  sizes?: string;
  style?: string;
}

const { src, alt, class: className = "", eager = false, sizes = "100vw", style } = Astro.props;
const pub = (p: string) => path.join(process.cwd(), "public", p);
const exists = fs.existsSync(pub(src));

const small = src.replace(/(\.[a-z]+)$/i, "-sm$1");
let srcset: string | undefined;
if (exists && fs.existsSync(pub(small))) {
  srcset = `${u(small)} 720w, ${u(src)} 1600w`;
}
---

{
  exists ? (
    <img
      src={u(src)}
      srcset={srcset}
      sizes={srcset ? sizes : undefined}
      alt={alt}
      class={className}
      style={style}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
    />
  ) : (
    <div
      role="img"
      aria-label={alt}
      class:list={[
        className,
        "relative flex items-center justify-center overflow-hidden bg-surface-lowest",
      ]}
    >
      <div
        class="absolute inset-0 opacity-40"
        style="background-image: repeating-linear-gradient(115deg, transparent 0 22px, rgba(200,0,0,.18) 22px 24px), radial-gradient(ellipse at 70% 80%, rgba(200,0,0,.35), transparent 60%);"
      />
      <div class="relative text-center px-4">
        <div class="telemetry text-red-soft">Photo slot</div>
        <div class="mt-1 font-mono text-micro text-ink-dim normal-case">public{src}</div>
      </div>
    </div>
  )
}
